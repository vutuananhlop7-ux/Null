-- =================================================================
-- QUẢN LÝ DANH SÁCH NHIỆM VỤ
-- =================================================================
local quests = {}
local activeQuest = nil
local seqCounter = 0

local function getQuestPosition(quest)
	if typeof(quest.Target) == "Vector3" then
		return quest.Target
	elseif typeof(quest.Target) == "Instance" and quest.Target.Parent then
		return instancePosition(quest.Target)
	end
	return nil
end

-- target: Instance hoặc Vector3
local function addQuest(target, name, order, radius, onReached)
	seqCounter += 1
	local quest = {
		Target = target,
		Name = name or "Nhiệm vụ",
		Order = order or 0,
		Radius = radius or CONFIG.DefaultRadius,
		OnReached = onReached,
		Seq = seqCounter,
	}
	table.insert(quests, quest)
	-- Nhiệm vụ mới ưu tiên cao hơn -> chọn lại
	if activeQuest and quest.Order < activeQuest.Order then
		activeQuest = nil
	end
	return quest
end

local function removeQuest(quest)
	local i = table.find(quests, quest)
	if i then
		table.remove(quests, i)
	end
	if activeQuest == quest then
		activeQuest = nil
	end
end

-- Chọn nhiệm vụ: Order nhỏ nhất, cùng Order thì gần người chơi nhất
local function pickActive()
	local root = getRoot()
	local best, bestDist
	for _, quest in ipairs(quests) do
		local pos = getQuestPosition(quest)
		if pos then
			local d = root and horizontalDistance(root.Position, pos) or 0
			if not best or quest.Order < best.Order or (quest.Order == best.Order and d < bestDist) then
				best, bestDist = quest, d
			end
		end
	end
	return best
end

-- =================================================================
-- ĐƯỜNG DẪN (Pathfinding) BẰNG CÁC CHẤM SÁNG
-- =================================================================
local dotFolder = Instance.new("Folder")
dotFolder.Name = "QuestPathDots"
dotFolder.Parent = workspace

local dots = {}
local pathBusy = false
local pathToken = 0
local lastPathTime = 0
local lastPathFrom = nil
local lastPathTo = nil

local function makeDot()
	local dot = Instance.new("Part")
	dot.Shape = Enum.PartType.Ball
	dot.Size = Vector3.new(0.9, 0.9, 0.9)
	dot.Anchored = true
	dot.CanCollide = false
	dot.CanQuery = false
	dot.CanTouch = false
	dot.CastShadow = false
	dot.Material = Enum.Material.Neon
	dot.Color = CONFIG.Color
	dot.Transparency = 0.2
	return dot
end

local function hidePath()
	for _, dot in ipairs(dots) do
		dot.Parent = nil
	end
end

local function showPath(waypoints)
	local step = math.max(1, math.ceil(#waypoints / CONFIG.PathMaxDots))
	local count = 0
	for i = 1, #waypoints, step do
		count += 1
		local dot = dots[count]
		if not dot then
			dot = makeDot()
			dots[count] = dot
		end
		dot.Position = waypoints[i].Position + Vector3.new(0, 0.6, 0)
		dot.Parent = dotFolder
	end
	for i = count + 1, #dots do
		dots[i].Parent = nil
	end
end

local function refreshPath(fromPos, toPos)
	if pathBusy then
		return
	end
	pathBusy = true
	lastPathTime = os.clock()
	lastPathFrom = fromPos
	lastPathTo = toPos
	local token = pathToken

	task.spawn(function()
		local path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true,
		})
		local ok = pcall(function()
			path:ComputeAsync(fromPos, toPos)
		end)
		-- Bỏ kết quả cũ nếu nhiệm vụ đã đổi trong lúc tính
		if token == pathToken then
			if ok and path.Status == Enum.PathStatus.Success then
				showPath(path:GetWaypoints())
			else
				hidePath()
			end
		end
		pathBusy = false
	end)
end

-- =================================================================
-- MARKER (vòng tròn + cột sáng + bảng tên) CHO NHIỆM VỤ ĐANG ACTIVE
-- =================================================================
local marker = nil -- { Part, Beam, Label, Quest, BaseCFrame, LastPos, Angle }

local function destroyMarker()
	if marker then
		marker.Part:Destroy()
		marker = nil
	end
	pathToken += 1
	lastPathFrom, lastPathTo = nil, nil
	hidePath()
	arrowFrame.Visible = false
end

local function buildMarker(quest)
	local part = Instance.new("Part")
	part.Name = "QuestMarker_" .. quest.Name
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(0.2, quest.Radius * 1.6, quest.Radius * 1.6)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = CONFIG.Color
	part.Transparency = 0.3
	part.Parent = workspace

	local a0 = Instance.new("Attachment")
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(CONFIG.BeamHeight, 0, 0) -- trục X cục bộ = hướng lên
	a1.Parent = part

	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = 6
	beam.Width1 = 2
	beam.Color = ColorSequence.new(CONFIG.Color)
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	beam.Parent = part

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(220, 55)
	billboard.StudsOffset = Vector3.new(0, 5, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.TextSize = 18
	label.Font = Enum.Font.SourceSansBold
	label.Text = quest.Name
	label.Parent = billboard

	marker = {
		Part = part,
		Beam = beam,
		Label = label,
		Quest = quest,
		BaseCFrame = nil,
		LastPos = nil,
		Angle = 0,
	}
end

-- =================================================================
-- MŨI TÊN CHỈ HƯỚNG KHI MỤC TIÊU NẰM NGOÀI MÀN HÌNH
-- =================================================================
local function updateArrow(worldPos, distText)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local v, onScreen = camera:WorldToViewportPoint(worldPos + Vector3.new(0, 5, 0))
	if onScreen then
		arrowFrame.Visible = false
		return
	end

	local size = camera.ViewportSize
	local center = size / 2
	local dir = Vector2.new(v.X, v.Y) - center
	if v.Z < 0 then
		dir = -dir -- mục tiêu ở phía sau camera
	end
	if dir.Magnitude < 1 then
		dir = Vector2.new(0, 1)
	end

	local m = CONFIG.ArrowMargin
	local sx = (center.X - m) / math.max(math.abs(dir.X), 1e-4)
	local sy = (center.Y - m) / math.max(math.abs(dir.Y), 1e-4)
	local scale = math.min(sx, sy)
	local pos = center + dir * scale

	arrowFrame.Position = UDim2.fromOffset(pos.X, pos.Y)
	arrowLabel.Rotation = math.deg(math.atan2(dir.Y, dir.X))
	arrowDist.Text = distText
	arrowFrame.Visible = true
end

-- =================================================================
-- VÒNG LẶP CẬP NHẬT CHÍNH
-- =================================================================
RunService.RenderStepped:Connect(function(dt)
	-- Chọn nhiệm vụ nếu chưa có
	if not activeQuest then
		activeQuest = pickActive()
	end

	-- Đổi nhiệm vụ -> dựng lại marker
	if (marker and marker.Quest ~= activeQuest) or (not activeQuest and marker) then
		destroyMarker()
	end
	if activeQuest and not marker then
		buildMarker(activeQuest)
	end
	if not activeQuest or not marker then
		return
	end

	-- Target bị huỷ -> bỏ qua nhiệm vụ này
	local targetPos = getQuestPosition(activeQuest)
	if not targetPos then
		removeQuest(activeQuest)
		return
	end

	-- Marker bám theo mục tiêu (kể cả khi mục tiêu di chuyển)
	if not marker.LastPos or (targetPos - marker.LastPos).Magnitude > 0.5 then
		marker.LastPos = targetPos
		marker.BaseCFrame = CFrame.new(snapToGround(targetPos)) * CFrame.Angles(0, 0, math.rad(90))
	end
	marker.Angle += CONFIG.SpinSpeed * dt

	local root = getRoot()
	if not root then
		marker.Part.CFrame = marker.BaseCFrame * CFrame.Angles(marker.Angle, 0, 0)
		return
	end

	local dist = horizontalDistance(root.Position, targetPos)

	-- Hiển thị thông minh theo khoảng cách
	local far = math.clamp(dist / CONFIG.FarDistance, 0, 1)      -- 0 = sát, 1 = rất xa
	marker.Beam.Width0 = 2 + 4 * far
	marker.Beam.Width1 = 1 + 1 * far
	marker.Beam.Enabled = dist > activeQuest.Radius * 1.5
	local pulseSpeed = 3 + (1 - far) * 6                          -- càng gần càng nhấp nháy nhanh
	marker.Part.Transparency = 0.35 + 0.2 * math.sin(os.clock() * pulseSpeed)
	marker.Part.CFrame = marker.BaseCFrame * CFrame.Angles(marker.Angle, 0, 0)

	local eta = dist / math.max(getWalkSpeed(), 1)
	local text = string.format("%.0fm", dist)
	marker.Label.Text = string.format("%s\n[%.1fm • ~%ds]", activeQuest.Name, dist, math.ceil(eta))
	updateArrow(targetPos, text)

	-- Đường dẫn: chỉ tính lại khi cần
	if CONFIG.ShowPath then
		if dist > CONFIG.PathMinDistance then
			local needRefresh = os.clock() - lastPathTime > CONFIG.PathRefreshTime
				and (
					not lastPathFrom
					or (root.Position - lastPathFrom).Magnitude > CONFIG.PathRefreshMoved
					or (lastPathTo and (targetPos - lastPathTo).Magnitude > 5)
				)
			if needRefresh then
				refreshPath(root.Position, targetPos)
			end
		else
			hidePath()
		end
	end

	-- Đến nơi -> hoàn thành, chuyển sang nhiệm vụ kế tiếp
	if dist <= activeQuest.Radius then
		local finished = activeQuest
		removeQuest(finished)
		destroyMarker()
		showToast("✔ Hoàn thành: " .. finished.Name)
		if finished.OnReached then
			task.spawn(finished.OnReached)
		end
	end
end)

-- =================================================================
-- TỰ PHÁT HIỆN NHIỆM VỤ QUA COLLECTIONSERVICE TAG
-- =================================================================
local tagged = {} -- instance -> quest

local function onTagAdded(instance)
	if tagged[instance] then
		return
	end
	tagged[instance] = addQuest(
		instance,
		instance:GetAttribute("QuestName") or instance.Name,
		instance:GetAttribute("QuestOrder") or 0,
		instance:GetAttribute("QuestRadius") or CONFIG.DefaultRadius,
		function()
			print("Hoàn thành nhiệm vụ:", instance.Name)
		end
	)
end

local function onTagRemoved(instance)
	local quest = tagged[instance]
	if quest then
		tagged[instance] = nil
		removeQuest(quest)
	end
end

CollectionService:GetInstanceAddedSignal(CONFIG.Tag):Connect(onTagAdded)
CollectionService:GetInstanceRemovedSignal(CONFIG.Tag):Connect(onTagRemoved)
for _, instance in ipairs(CollectionService:GetTagged(CONFIG.Tag)) do
	onTagAdded(instance)
end

