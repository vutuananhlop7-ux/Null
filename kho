	QuestBaseName = "Phòng không",
	QuestOrder = 4,
	QuestRadius = 8,

	MinScore = 40,        -- đủ điểm này mới được tự động gắn tag
	NearScore = 15,       -- từ mức này trở lên được liệt kê ở mục "Gần đúng" (để bạn tự chọn)
	MaxTargets = 12,      -- tối đa số điểm tự gắn tag
	MaxNear = 8,

	RescanInterval = 6,   -- giây, tối thiểu giữa hai lần quét tự động
	YieldEvery = 1500,    -- nhường CPU sau mỗi N instance để không giật

	Highlight = true,     -- tô sáng các điểm tìm được (chỉ thấy trên máy bạn)
	Debug = true,         -- in chi tiết vào Output

	-- Từ khoá dài: khớp nếu tên (bỏ dấu, bỏ khoảng trắng/gạch dưới, chữ thường) CHỨA từ này
	LongKeywords = {
		"antiair", "antiaircraft", "airdefense", "airdefence", "flak",
		"aagun", "aasite", "aaturret", "aabattery", "aaemplacement",
		"samsite", "phongkhong", "airdefensenode",
	},
	-- Từ khoá ngắn: chỉ khớp khi là MỘT TỪ riêng (tránh nhầm "Sample", "Palace"...)
	ShortTokens = { "aa", "sam", "aad" },

	-- Tên của các "marker nhiệm vụ" mà chính game có thể tự tạo
	MarkerWords = {
		"quest", "objective", "waypoint", "mission", "marker",
		"beacon", "nhiemvu", "muctieu",
	},
	-- Tên nên bị loại
	BadNames = { "baseplate", "terrain", "water", "ocean", "skybox", "spawnlocation" },
}

-- =====================================================================
-- TRẠNG THÁI
-- =====================================================================
local state = {
	locText = "",       -- chữ vị trí đọc từ UI của game
	locNorm = "",
	locTokens = {},
	scanning = false,
	dirty = true,
	lastScan = -math.huge,
	results = {},       -- điểm hợp lệ lần quét gần nhất
	near = {},          -- điểm gần đúng
	tagged = {},        -- [instance] = { Score, Reasons, Name, Pinned }
	highlights = {},    -- [instance] = Highlight
	scanCount = 0,
}
local scoreCache = {}

-- =====================================================================
-- XỬ LÝ CHỮ: bỏ dấu tiếng Việt, chuẩn hoá, tách từ
-- =====================================================================
local charMap = {}
do
	local lower = {
		a = "àáạảãâầấậẩẫăằắặẳẵ",
		e = "èéẹẻẽêềếệểễ",
		i = "ìíịỉĩ",
		o = "òóọỏõôồốộổỗơờớợởỡ",
		u = "ùúụủũưừứựửữ",
		y = "ỳýỵỷỹ",
		d = "đ",
	}
	local upper = {
		a = "ÀÁẠẢÃÂẦẤẬẨẪĂẰẮẶẲẴ",
		e = "ÈÉẸẺẼÊỀẾỆỂỄ",
		i = "ÌÍỊỈĨ",
		o = "ÒÓỌỎÕÔỒỐỘỔỖƠỜỚỢỞỠ",
		u = "ÙÚỤỦŨƯỪỨỰỬỮ",
		y = "ỲÝỴỶỸ",
		d = "Đ",
	}
	for _, group in ipairs({ lower, upper }) do
		for base, chars in pairs(group) do
			for _, cp in utf8.codes(chars) do
				charMap[utf8.char(cp)] = base
			end
		end
	end
end

local function stripDiacritics(s)
	local out = s:gsub(utf8.charpattern, function(ch)
		local mapped = charMap[ch]
		if mapped then
			return mapped
		end
		local ok, cp = pcall(utf8.codepoint, ch)
		if ok and cp >= 0x300 and cp <= 0x36F then
			return "" -- dấu kết hợp
		end
		return ch
	end)
	return out
end

local function normalize(name)
	local s = stripDiacritics(name):lower()
	return (s:gsub("[^%w]", ""))
end

local function tokenSet(name)
	local stripped = stripDiacritics(name)
	local spaced = stripped:gsub("(%l)(%u)", "%1 %2") -- "AntiAir" -> "Anti Air"
	local set = {}
	for word in spaced:lower():gmatch("%a+") do
		set[word] = true
	end
	return set
end

local function containsAny(norm, list)
	for _, kw in ipairs(list) do
		if norm:find(kw, 1, true) then
			return kw
		end
	end
	return nil
end

-- =====================================================================
-- CHẤM ĐIỂM TÊN
-- =====================================================================
local function keywordScore(name)
	local norm = normalize(name)
	if norm == "" then
		return 0, nil
	end
	local kw = containsAny(norm, CONFIG.LongKeywords)
	if kw then
		return 60, "tên chứa '" .. kw .. "'"
	end
	local tokens = tokenSet(name)
	for _, short in ipairs(CONFIG.ShortTokens) do
		if tokens[short] then
			return 50, "tên có từ '" .. short .. "'"
		end
	end
	return 0, nil
end

local function locationScore(name)
	if state.locNorm == "" then
		return 0, nil
	end
	local norm = normalize(name)
	if #norm >= 6 and state.locNorm:find(norm, 1, true) then
		return 55, "khớp vị trí quest trên UI"
	end
	local hits = 0
	for word in pairs(tokenSet(name)) do
		if #word >= 4 and state.locTokens[word] then
			hits += 1
		end
	end
	if hits >= 2 then
		return 55, "khớp vị trí quest trên UI"
	elseif hits == 1 then
		return 20, "gần khớp vị trí quest"
	end
	return 0, nil
end

local function scoreName(name)
	local cached = scoreCache[name]
	if cached then
		return cached[1], cached[2]
	end
	local s, r = keywordScore(name)
	if s == 0 then
		s, r = locationScore(name)
	end
	scoreCache[name] = { s, r }
	return s, r
end

local function isMarkerName(name)
	return containsAny(normalize(name), CONFIG.MarkerWords) ~= nil
end

local function isBadName(name)
	return containsAny(normalize(name), CONFIG.BadNames) ~= nil
end

-- Bỏ qua các object do chính hệ thống này / SmartQuestGuide tạo
local function isOwn(inst)
	local n = inst.Name
	return n:sub(1, 3) == "QF_" or n:sub(1, 12) == "QuestMarker_" or n == "QuestPathDots"
end

-- =====================================================================
-- TIỆN ÍCH KHÁC
-- =====================================================================
local function getRoot()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function getPosition(inst)
	if inst:IsA("BasePart") then
		return inst.Position
	elseif inst:IsA("Model") then
		local ok, pivot = pcall(function()
			return inst:GetPivot()
		end)
		return ok and pivot.Position or nil
	end
	return nil
end

local function sizeOf(inst)
	if inst:IsA("Model") then
		local ok, s = pcall(function()
			return inst:GetExtentsSize()
		end)
		return ok and s.Magnitude or 0
	end
	return inst.Size.Magnitude
end

local function depthOf(inst)
	local d, p = 0, inst.Parent
	while p do
		d += 1
		p = p.Parent
	end
	return d
end

local function isInsideCharacter(inst)
	for _, plr in ipairs(Players:GetPlayers()) do
		local ch = plr.Character
		if ch and inst:IsDescendantOf(ch) then
			return true
		end
	end
	return false
end

local function holderOf(inst)
	local p = inst.Parent
	while p and p ~= Workspace do
		if p:IsA("BasePart") or p:IsA("Model") then
			return p
		end
		p = p.Parent
	end
	return nil
end

local function make(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

