-- PANEL: HIỂN THỊ KẾT QUẢ + GHIM THỦ CÔNG
-- =====================================================================
local pin -- khai báo trước (dùng trong refreshPanel)

local function distTo(inst)
	local root = getRoot()
	local pos = getPosition(inst)
	if root and pos then
		return (root.Position - pos).Magnitude
	end
	return 0
end

local function refreshPanel()
	for _, child in ipairs(listFrame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	local order = 0
	local function header(text)
		order += 1
		make("TextLabel", {
			Size = UDim2.new(1, -6, 0, 20),
			BackgroundTransparency = 1,
			Text = text,
			TextSize = 14,
			Font = Enum.Font.SourceSansBold,
			TextColor3 = Color3.fromRGB(255, 210, 90),
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = order,
		}, listFrame)
	end

	local function row(r, good)
		order += 1
		local frame = make("Frame", {
			Size = UDim2.new(1, -6, 0, 48),
			BackgroundColor3 = good and Color3.fromRGB(26, 56, 62) or Color3.fromRGB(38, 38, 44),
			LayoutOrder = order,
		}, listFrame)
		make("UICorner", { CornerRadius = UDim.new(0, 6) }, frame)

		local pinned = state.tagged[r.Inst] and state.tagged[r.Inst].Pinned
		local reasons = {}
		for i = 1, math.min(#r.Reasons, 2) do
			reasons[i] = r.Reasons[i]
		end
		make("TextLabel", {
			Size = UDim2.new(1, -72, 1, 0),
			Position = UDim2.fromOffset(6, 0),
			BackgroundTransparency = 1,
			Text = string.format(
				"%s%s  [%d điểm • %dm]\n%s",
				pinned and "★ " or "",
				r.Inst.Name,
				r.Score,
				distTo(r.Inst),
				table.concat(reasons, ", ")
			),
			TextSize = 13,
			Font = Enum.Font.SourceSans,
			TextColor3 = Color3.new(1, 1, 1),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, frame)

		local btn = make("TextButton", {
			Size = UDim2.fromOffset(58, 30),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			BackgroundColor3 = Color3.fromRGB(0, 140, 90),
			Text = "Chọn",
			TextSize = 15,
			Font = Enum.Font.SourceSansBold,
			TextColor3 = Color3.new(1, 1, 1),
		}, frame)
		make("UICorner", { CornerRadius = UDim.new(0, 6) }, btn)
		btn.Activated:Connect(function()
			pin(r.Inst)
		end)
	end

	if #state.results > 0 then
		header("Điểm tìm được (đã gắn tag)")
		for _, r in ipairs(state.results) do
			row(r, true)
		end
	end
	if #state.near > 0 then
		header("Gần đúng — bấm Chọn nếu đúng")
		for _, r in ipairs(state.near) do
			row(r, false)
		end
	end

	statusLabel.Text = string.format(
		"Hợp lệ: %d • Gần đúng: %d • Lần quét: %d\nVị trí quest (UI): %s",
		#state.results,
		#state.near,
		state.scanCount,
		state.locText ~= "" and state.locText or "(chưa đọc được)"
	)
end

pin = function(inst)
	if not inst.Parent then
		return
	end
	for _, info in pairs(state.tagged) do
		info.Pinned = false
	end
	local info = state.tagged[inst] or { Score = 0, Reasons = { "chọn thủ công" }, Name = inst.Name }
	info.Pinned = true
	tagTarget(inst, "★ " .. (info.Name or inst.Name), 0, info)
	refreshPanel()
end

-- =====================================================================
-- ĐỌC CHỮ "VỊ TRÍ: ..." TỪ UI NHIỆM VỤ CỦA GAME
-- =====================================================================
local function isShown(obj)
	local cur = obj
	while cur and cur ~= playerGui do
		if cur:IsA("GuiObject") and not cur.Visible then
			return false
		end
		if cur:IsA("LayerCollector") and not cur.Enabled then
			return false
		end
		cur = cur.Parent
	end
	return true
end

local function readQuestLocation()
	for _, obj in ipairs(playerGui:GetDescendants()) do
		if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Text ~= "" and not obj:IsDescendantOf(gui) then
			local raw = obj.Text:gsub("<[^>]+>", "")
			local plain = stripDiacritics(raw):lower()
			if plain:match("^%s*vi%s*tri%s*:") or plain:match("^%s*location%s*:") or plain:match("^%s*dia%s*diem%s*:") then
				if isShown(obj) then
					local value = raw:match("^[^:]*:%s*(.+)$")
					if value then
						return (value:gsub("^%s+", ""):gsub("%s+$", ""))
					end
				end
			end
		end
	end
	return ""
end

local function setLocation(text)
	state.locText = text
	local stripped = stripDiacritics(text):lower()
	state.locNorm = (stripped:gsub("[^%w]", ""))
	state.locTokens = {}
	for word in stripped:gmatch("%a+") do
		if #word >= 4 then
			state.locTokens[word] = true
		end
	end
	table.clear(scoreCache)
	state.dirty = true
end

-- =====================================================================
-- QUÉT WORKSPACE + CHẤM ĐIỂM
-- =====================================================================
local function scan()
	local nameScores = {}   -- [instance] = { điểm, lý do }
	local hasHumanoid = {}
	local hasHealth = {}
	local markerHits = {}
	local attrHits = {}
	local cands = {}

	-- ---------- Lượt 1: thu thập dấu hiệu ----------
	local descendants = Workspace:GetDescendants()
	for i, inst in ipairs(descendants) do
		if i % CONFIG.YieldEvery == 0 then
			task.wait()
		end
		if not inst.Parent or isOwn(inst) or inst:IsA("Terrain") then
			continue
		end

		if inst:IsA("Model") or inst:IsA("BasePart") then
			cands[#cands + 1] = inst
		end

		local s, why = scoreName(inst.Name)
		if s > 0 then
			nameScores[inst] = { s, why }
		end

		if inst:IsA("Humanoid") then
			local m = inst.Parent
			if m then
				hasHumanoid[m] = true
			end
		elseif (inst:IsA("NumberValue") or inst:IsA("IntValue")) and inst.Name:lower():find("health", 1, true) then
			local m = inst.Parent
			if m then
				hasHealth[m] = true
			end
		elseif inst:IsA("Beam") or inst:IsA("Highlight") or inst:IsA("BillboardGui") or inst:IsA("Attachment") then
			if isMarkerName(inst.Name) then
				local holder = holderOf(inst)
				if holder then
					markerHits[holder] = true
				end
			end
		end

		if inst:IsA("Model") then
			-- Tag / Attribute có sẵn của game
			local ok = pcall(function()
				for _, tg in ipairs(CollectionService:GetTags(inst)) do
					if tg ~= CONFIG.Tag and keywordScore(tg) > 0 then
						attrHits[inst] = true
					end
				end
				for k, v in pairs(inst:GetAttributes()) do
					if keywordScore(tostring(k)) > 0 or (typeof(v) == "string" and keywordScore(v) > 0) then
						attrHits[inst] = true
					end
				end
			end)
			if not ok then
				attrHits[inst] = nil
			end
		end
	end

	-- ---------- Lượt 2: chấm điểm từng ứng viên ----------
	local scored = {}
	for i, inst in ipairs(cands) do
		if i % CONFIG.YieldEvery == 0 then
			task.wait()
		end
		if not inst.Parent then
			continue
		end

		local score, reasons = 0, {}

		local ns = nameScores[inst]
		if ns then
			score += ns[1]
			reasons[#reasons + 1] = ns[2]
		end

		-- Tên của Folder/Model cha (tối đa 3 cấp)
		local p, depth = inst.Parent, 0
		while p and p ~= Workspace and depth < 3 do
			local ans = nameScores[p]
			if ans then
				score += math.floor(ans[1] * 0.75)
				reasons[#reasons + 1] = "nằm trong '" .. p.Name .. "'"
				break
			end
			p = p.Parent
			depth += 1
		end

		if markerHits[inst] then
			score += 45
			reasons[#reasons + 1] = "có marker nhiệm vụ của game"
		end
		if attrHits[inst] then
			score += 30
			reasons[#reasons + 1] = "Tag/Attribute khớp từ khoá"
		end

		if score > 0 then
			if hasHumanoid[inst] then
				score += 10
				reasons[#reasons + 1] = "có Humanoid"
			end
			if hasHealth[inst] then
				score += 15
				reasons[#reasons + 1] = "có Health"
			end

			local size = sizeOf(inst)
			if size > 400 then
				score -= 50
				reasons[#reasons + 1] = "quá lớn"
			elseif inst:IsA("BasePart") and size < 0.5 then
				score -= 20
				reasons[#reasons + 1] = "quá nhỏ"
			end
			if isBadName(inst.Name) then
				score -= 100
			end

			local gameOwned = CollectionService:HasTag(inst, CONFIG.Tag) and not state.tagged[inst]
			if score >= CONFIG.NearScore and not gameOwned and not isInsideCharacter(inst) then
				scored[#scored + 1] = {
					Inst = inst,
					Score = score,
					Reasons = reasons,
					Depth = depthOf(inst),
				}
			end
		end
	end

	-- ---------- Lượt 3: chọn "topmost" (cha thắng con) ----------
	table.sort(scored, function(a, b)
		if a.Depth ~= b.Depth then
			return a.Depth < b.Depth
		end
		return a.Score > b.Score
	end)

	local accepted, near, acceptedSet = {}, {}, {}
	for _, r in ipairs(scored) do
		local covered = false
		local p = r.Inst.Parent
		while p and p ~= Workspace do
			if acceptedSet[p] then
				covered = true
				break
			end
			p = p.Parent
		end
		if not covered then
			if r.Score >= CONFIG.MinScore then
				accepted[#accepted + 1] = r
				acceptedSet[r.Inst] = true
			else
				near[#near + 1] = r
			end
		end
	end

	for _, r in ipairs(accepted) do
		r.Dist = distTo(r.Inst)
	end
	for _, r in ipairs(near) do
		r.Dist = distTo(r.Inst)
	end

	table.sort(accepted, function(a, b)
		if a.Score ~= b.Score then
			return a.Score > b.Score
		end
		return a.Dist < b.Dist
	end)
	while #accepted > CONFIG.MaxTargets do
		local dropped = table.remove(accepted)
		acceptedSet[dropped.Inst] = nil
	end

	table.sort(near, function(a, b)
		if a.Score ~= b.Score then
			return a.Score > b.Score
		end
		return a.Dist < b.Dist
	end)
	while #near > CONFIG.MaxNear do
		table.remove(near)
	end

	-- ---------- Đồng bộ tag ----------
	for inst, info in pairs(state.tagged) do
		if not inst.Parent then
			removeHighlight(inst)
			state.tagged[inst] = nil
		elseif not acceptedSet[inst] and not info.Pinned then
			untag(inst)
		end
	end

	-- Đặt tên theo thứ tự gần -> xa
	local byDist = table.clone(accepted)
	table.sort(byDist, function(a, b)
		return a.Dist < b.Dist
	end)
	local nameIndex = 0
	for _, r in ipairs(byDist) do
		local existing = state.tagged[r.Inst]
		if existing then
			existing.Score = r.Score
			existing.Reasons = r.Reasons
		else
			nameIndex += 1
			-- tránh trùng số với tên đã dùng
			local used = 0
			for _ in pairs(state.tagged) do
				used += 1
			end
			tagTarget(r.Inst, CONFIG.QuestBaseName .. " " .. (used + 1), CONFIG.QuestOrder, {
				Score = r.Score,
				Reasons = r.Reasons,
				Pinned = false,
			})
		end
	end

	state.results = accepted
	state.near = near
	state.scanCount += 1

	if CONFIG.Debug then
		print(string.format("[QuestAutoFinder] Quét #%d xong: %d hợp lệ, %d gần đúng. Vị trí quest UI: '%s'",
			state.scanCount, #accepted, #near, state.locText))
		for i, r in ipairs(accepted) do
			local pos = getPosition(r.Inst)
			print(string.format("  #%d [%d điểm] %s @ (%.0f, %.0f, %.0f)  — %s",
				i, r.Score, r.Inst:GetFullName(),
				pos and pos.X or 0, pos and pos.Y or 0, pos and pos.Z or 0,
				table.concat(r.Reasons, "; ")))
		end
		for i, r in ipairs(near) do
			print(string.format("  ~%d [%d điểm] %s — %s", i, r.Score, r.Inst:GetFullName(), table.concat(r.Reasons, "; ")))
		end
	end
end

local function safeScan()
	if state.scanning then
		return
	end
	state.scanning = true
	state.dirty = false
	statusLabel.Text = "Đang quét workspace..."
	local ok, err = pcall(scan)
	state.scanning = false
	state.lastScan = os.clock()
	if not ok then
		warn("[QuestAutoFinder] Lỗi khi quét: " .. tostring(err))
		statusLabel.Text = "Lỗi khi quét (xem Output)."
		return
	end
	refreshPanel()
	-- Không tìm thấy gì -> tự mở panel để bạn thấy
	if #state.results == 0 and state.scanCount == 1 then
		panel.Visible = true
	end
	if #state.results == 0 and CONFIG.Debug then
		warn("[QuestAutoFinder] Không có điểm nào đủ điểm. Cấu trúc workspace (để xem tên thật):")
		for _, child in ipairs(Workspace:GetChildren()) do
			if not child:IsA("Terrain") and not child:IsA("Camera") and not isOwn(child) then
				local names = {}
				for i, c in ipairs(child:GetChildren()) do
					if i > 8 then
						names[#names + 1] = "..."
						break
					end
					names[#names + 1] = c.Name
				end
				print(string.format("  %s [%s] -> %s", child.Name, child.ClassName, table.concat(names, ", ")))
			end
		end
	end
end

-- =====================================================================
-- SỰ KIỆN + VÒNG LẶP CHÍNH
-- =====================================================================
toggleBtn.Activated:Connect(function()
	panel.Visible = not panel.Visible
	if panel.Visible then
		refreshPanel()
	end
end)

closeBtn.Activated:Connect(function()
	panel.Visible = false
end)

rescanBtn.Activated:Connect(function()
	setLocation(readQuestLocation())
	task.spawn(safeScan)
end)

-- Có object liên quan xuất hiện (streaming, spawn động) -> đánh dấu cần quét lại
Workspace.DescendantAdded:Connect(function(inst)
	if isOwn(inst) then
		return
	end
	if inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Beam") or inst:IsA("BillboardGui") or inst:IsA("Highlight") then
		if scoreName(inst.Name) > 0 or isMarkerName(inst.Name) then
			state.dirty = true
		end
	end
end)

-- Mục tiêu bị xoá -> dọn tag/highlight
Workspace.DescendantRemoving:Connect(function(inst)
	if state.tagged[inst] then
		removeHighlight(inst)
		state.tagged[inst] = nil
		state.dirty = true
	end
end)

task.spawn(function()
	while true do
		local loc = readQuestLocation()
		if loc ~= state.locText then
			setLocation(loc)
		end
		if state.dirty and not state.scanning and os.clock() - state.lastScan >= CONFIG.RescanInterval then
			safeScan()
		end
		task.wait(1)
	end
end)
