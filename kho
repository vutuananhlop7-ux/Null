-- =====================================================================
-- GẮN / GỠ TAG + HIGHLIGHT
-- =====================================================================
local function addHighlight(inst)
	if not CONFIG.Highlight or state.highlights[inst] then
		return
	end
	local ok, hl = pcall(function()
		return make("Highlight", {
			Name = "QF_Highlight",
			Adornee = inst,
			FillColor = Color3.fromRGB(0, 255, 255),
			FillTransparency = 0.7,
			OutlineColor = Color3.new(1, 1, 1),
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		}, inst)
	end)
	if ok then
		state.highlights[inst] = hl
	end
end

local function removeHighlight(inst)
	local hl = state.highlights[inst]
	if hl then
		hl:Destroy()
		state.highlights[inst] = nil
	end
end

local function tagTarget(inst, name, order, info)
	info.Name = name
	inst:SetAttribute("QuestName", name)
	inst:SetAttribute("QuestOrder", order)
	inst:SetAttribute("QuestRadius", CONFIG.QuestRadius)
	-- Gỡ rồi thêm lại để SmartQuestGuide đọc lại Attributes mới
	if CollectionService:HasTag(inst, CONFIG.Tag) then
		CollectionService:RemoveTag(inst, CONFIG.Tag)
	end
	CollectionService:AddTag(inst, CONFIG.Tag)
	state.tagged[inst] = info
	addHighlight(inst)
end

local function untag(inst)
	if CollectionService:HasTag(inst, CONFIG.Tag) then
		CollectionService:RemoveTag(inst, CONFIG.Tag)
	end
	removeHighlight(inst)
	state.tagged[inst] = nil
end

