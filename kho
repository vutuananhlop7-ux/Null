-- LocalScript: đặt trong StarterPlayer > StarterPlayerScripts
--
-- CÁCH DÙNG (không cần sửa code):
--   1. Chọn Part/Model làm điểm nhiệm vụ -> thêm Tag "QuestTarget" (Tag Editor trong Studio).
--   2. (Tuỳ chọn) đặt Attributes cho nó:
--        QuestName  (string) : tên hiển thị
--        QuestOrder (number) : thứ tự nhiệm vụ (nhỏ làm trước). Cùng Order -> chọn cái gần nhất.
--        QuestRadius(number) : bán kính hoàn thành (mặc định 5 studs)
--
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

-- =================================================================
-- CẤU HÌNH
-- =================================================================
local CONFIG = {
	Tag = "QuestTarget",
	DefaultRadius = 5,
	BeamHeight = 20,
	SpinSpeed = math.rad(120),
	Color = Color3.fromRGB(0, 255, 255),

	ShowPath = true,          -- vẽ đường đi bằng các chấm sáng
	PathMinDistance = 15,     -- gần hơn mức này thì ẩn đường đi
	PathRefreshTime = 2.5,    -- giây, tối thiểu giữa 2 lần tính lại
	PathRefreshMoved = 12,    -- studs người chơi đi lệch thì tính lại
	PathMaxDots = 40,

	ArrowMargin = 60,         -- px cách mép màn hình
	FarDistance = 60,         -- xa hơn mức này: cột sáng to nhất
}

-- =================================================================
-- TIỆN ÍCH
-- =================================================================
local function getRoot()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function getWalkSpeed()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid and humanoid.WalkSpeed or 16
end

local function instancePosition(instance)
	if instance:IsA("BasePart") then
		return instance.Position
	elseif instance:IsA("Model") then
		return instance:GetPivot().Position
	end
	return nil
end

local function snapToGround(position)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local result = workspace:Raycast(position + Vector3.new(0, 5, 0), Vector3.new(0, -100, 0), params)
	return result and (result.Position + Vector3.new(0, 0.1, 0)) or position
end

local function horizontalDistance(a, b)
	local d = a - b
	return Vector3.new(d.X, 0, d.Z).Magnitude
end

