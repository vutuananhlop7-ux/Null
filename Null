local function addToggle(container, labelText, stateTable, stateKey, callback)
	local frame = Instance.new("Frame", container)
	frame.Size = UDim2.new(0.96, 0, 0, 38)
	frame.BackgroundTransparency = 1
	
	local label = Instance.new("TextLabel", frame)
	label.Size = UDim2.new(0.65, 0, 1, 0)
	label.Text = "  " .. labelText
	label.Font = Enum.Font.SourceSans
	label.TextSize = 14
	label.TextColor3 = Color3.fromRGB(230, 230, 230)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.BackgroundTransparency = 1
	
	local btn = Instance.new("TextButton", frame)
	btn.Size = UDim2.new(0.3, 0, 0.8, 0)
	btn.Position = UDim2.new(0.68, 0, 0.1, 0)
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 12
	btn.TextColor3 = Color3.new(1, 1, 1)
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
	
	local function setVisual()
		local isAct = stateTable[stateKey]
		btn.Text = isAct and "ON" or "OFF"
		btn.BackgroundColor3 = isAct and Color3.fromRGB(46, 124, 85) or Color3.fromRGB(154, 56, 56)
	end
	
	setVisual()
	btn.MouseButton1Click:Connect(function()
		stateTable[stateKey] = not stateTable[stateKey]
		setVisual()
		if callback then callback(stateTable[stateKey]) end
	end)
end

--========================
-- 🔴 XỬ LÝ HỆ THỐNG ESP (TÌM ĐỊCH)
--========================
local function clearESP(character)
	if espCache[character] then
		for _, item in ipairs(espCache[character]) do
			pcall(function() if typeof(item) == "RBXScriptConnection" then item:Disconnect() else item:Destroy() end end)
		end
		espCache[character] = nil
	end
end

local function createESP(plr, character)
	if not states.espGlobal or espCache[character] then return end
	local head = character:FindFirstChild("Head")
	local root = character:FindFirstChild("HumanoidRootPart")
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not head or not root or not hum then return end

	local cacheObjects = {}

	if states.espHighlight then
		local hl = Instance.new("Highlight", character)
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillColor = Color3.fromRGB(255, 60, 60)
		hl.FillTransparency = 0.5
		table.insert(cacheObjects, hl)
	end

	if states.espName or states.espDistance then
		local bill = Instance.new("BillboardGui", head)
		bill.Size = UDim2.new(0, 140, 0, 30)
		bill.AlwaysOnTop = true

		local txt = Instance.new("TextLabel", bill)
		txt.Size = UDim2.new(1, 0, 1, 0)
		txt.BackgroundTransparency = 1
		txt.TextColor3 = Color3.new(1, 1, 1)
		txt.TextSize = 11
		txt.Font = Enum.Font.SourceSansBold

		local conn = RunService.Heartbeat:Connect(function()
			if not character.Parent or not head.Parent then conn:Disconnect() return end
			local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if myRoot then
				local dist = (myRoot.Position - root.Position).Magnitude
				if dist > 300 then txt.Text = "" return end
				local display = {}
				if states.espName then table.insert(display, plr.Name) end
				if states.espDistance then table.insert(display, math.floor(dist) .. "m") end
				txt.Text = table.concat(display, " | ")
			end
		end)
		table.insert(cacheObjects, conn)
		table.insert(cacheObjects, bill)
	end
	espCache[character] = cacheObjects
end

local function forceRefreshESP()
	for char, _ in pairs(espCache) do clearESP(char) end
	for _, p in ipairs(Players:GetPlayers()) do if p ~= player and p.Character then createESP(p, p.Character) end end
end

--========================
-- 🔥 SỬA LỖI COMBAT KHÔNG CHẠY (KNIFE ARENA BYPASS)
--========================
local function scanKnifeTarget()
	local best = nil
	local minDist = math.huge
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and not p.Character:FindFirstChildOfClass("ForceField") then
				local d = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
				if d < minDist then
					if lastTarget == p and targetStuckTimer > 3.5 then continue end
					minDist = d
					best = p
				end
			end
		end
	end
	return best
end

-- Cơ chế chém vây bắt trực tiếp (Không dùng VirtualUser)
local function executeKnifeSlash()
	pcall(function()
		-- 1. Ép nhân vật lôi dao ra từ tất cả mọi nguồn (Backpack)
		local tool = player.Character:FindFirstChildOfClass("Tool") or player.Backpack:FindFirstChildOfClass("Tool")
		if tool then
			if tool.Parent ~= player.Character then tool.Parent = player.Character end
			tool:Activate() -- Lệnh kích hoạt dùng vũ khí gốc của hệ thống Roblox
		end
		
		-- 2. Đấu trường Knife Arena Bypass: Bắn phá Remote sự kiện chém của game Đấu trường dao
		for _, child in ipairs(ReplicatedStorage:GetDescendants()) do
			if child:IsA("RemoteEvent") and (string.find(string.lower(child.Name), "slash") or string.find(string.lower(child.Name), "swing") or string.find(string.lower(child.Name), "attack") or string.find(string.lower(child.Name), "knife") or string.find(string.lower(child.Name), "hit")) then
				child:FireServer()
			end
		end
	end)
end

task.spawn(function()
	while true do
		task.wait(0.12) -- Tần suất quét siêu cao (0.12 giây) để triệt hạ phòng đấu trường
		local target = scanKnifeTarget()
		if target and target.Character and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local tRoot = target.Character.HumanoidRootPart
			local myRoot = player.Character.HumanoidRootPart

			if lastTarget == target then targetStuckTimer = targetStuckTimer + 0.12 else lastTarget = target targetStuckTimer = 0 end

			-- Auto Teleport ngắt quãng (Bypass bộ quét vị trí của server chống lag)
			if states.autoTeleport and tick() - teleportTick > 0.08 then
				myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2.5) -- Đứng sát sau lưng mục tiêu
				teleportTick = tick()
			end

			-- Vòng lặp kích hoạt Combat Aura
			if states.killAura then
				local dist = (myRoot.Position - tRoot.Position).Magnitude
				if dist <= states.killAuraRange then
					camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, tRoot.Position), 0.5)
					executeKnifeSlash()
					
					if target.Character.Humanoid.Health <= 0 then
						totalKillsSession = totalKillsSession + 1
						killLabel.Text = "Kills Đã Đạt: " .. totalKillsSession
						task.wait(0.1)
					end
				end
			end
		else
			targetStuckTimer = 0
		end
	end
end)

--========================
-- 🌐 LOOPS GIẢ LAG & DI CHUYỂN
--========================
local lagTick = tick()
RunService.Heartbeat:Connect(function()
	if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
	local root = player.Character.HumanoidRootPart

	if states.noclip then
		for _, v in ipairs(player.Character:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end
	end

	if states.fly then
		if not root:FindFirstChild("NovaFlyV") then
			local bv = Instance.new("BodyVelocity", root) bv.Name = "NovaFlyV" bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
			local bg = Instance.new("BodyGyro", root) bg.Name = "NovaFlyG" bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
		end
		root.NovaFlyV.velocity = camera.CFrame.LookVector * states.flySpeed
		root.NovaFlyG.cframe = camera.CFrame
	else
		if root:FindFirstChild("NovaFlyV") then root.NovaFlyV:Destroy() end
		if root:FindFirstChild("NovaFlyG") then root.NovaFlyG:Destroy() end
	end

	-- Giả Lag (Fake Lag Bypass)
	if states.fakeLag then
		if states.autoTeleport and lastTarget then
			settings().Network.IncomingReplicationLag = 0
		elseif tick() - lagTick >= states.fakeLagAmount then
			lagTick = tick()
			settings().Network.IncomingReplicationLag = states.fakeLagAmount
		else
			settings().Network.IncomingReplicationLag = 0
		end
	else
		pcall(function() settings().Network.IncomingReplicationLag = 0 end)
	end
end)

