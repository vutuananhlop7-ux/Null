local function addToggle(container, labelText, stateTable, stateKey, callback)
	local frame = Instance.new("Frame", container)
	frame.Size = UDim2.new(0.96, 0, 0, 38)
	frame.BackgroundTransparency = 1
	
	local label = Instance.new("TextLabel", frame)
	label.Size = UDim2.new(0.65, 0, 1, 0)
	label.Text = "  " .. labelText
	label.Font = Enum.Font.SourceSans
	label.TextSize = 14
	label.TextColor3 = Color3.fromRGB(230, 230, 230)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.BackgroundTransparency = 1
	
	local btn = Instance.new("TextButton", frame)
	btn.Size = UDim2.new(0.3, 0, 0.8, 0)
	btn.Position = UDim2.new(0.68, 0, 0.1, 0)
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 12
	btn.TextColor3 = Color3.new(1, 1, 1)
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
	
	local function setVisual()
		local isAct = stateTable[stateKey]
		btn.Text = isAct and "ON" or "OFF"
		btn.BackgroundColor3 = isAct and Color3.fromRGB(46, 124, 85) or Color3.fromRGB(154, 56, 56)
	end
	
	setVisual()
	btn.MouseButton1Click:Connect(function()
		stateTable[stateKey] = not stateTable[stateKey]
		setVisual()
		if callback then callback(stateTable[stateKey]) end
	end)
end

--========================
-- 🔴 HỆ THỐNG ESP BẢO MẬT
--========================
local function clearESP(character)
	if espCache[character] then
		for _, item in ipairs(espCache[character]) do
			pcall(function() 
				if item then
					if typeof(item) == "RBXScriptConnection" then 
						item:Disconnect() 
					else 
						item:Destroy() 
					end 
				end
			end)
		end
		espCache[character] = nil
	end
end

local function createESP(customName, character)
	if not states.espGlobal or espCache[character] then return end
	local head = character:FindFirstChild("Head")
	local root = character:FindFirstChild("HumanoidRootPart")
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not head or not root or not hum then return end

	local cacheObjects = {}

	if states.espHighlight then
		local hl = Instance.new("Highlight", character)
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillColor = Color3.fromRGB(255, 60, 60)
		hl.FillTransparency = 0.5
		table.insert(cacheObjects, hl)
	end

	if states.espName or states.espDistance then
		local bill = Instance.new("BillboardGui", head)
		bill.Size = UDim2.new(0, 140, 0, 40)
		bill.AlwaysOnTop = true

		local txt = Instance.new("TextLabel", bill)
		txt.Size = UDim2.new(1, 0, 0.5, 0)
		txt.BackgroundTransparency = 1
		txt.TextColor3 = Color3.new(1, 1, 1)
		txt.TextSize = 11
		txt.Font = Enum.Font.SourceSansBold

		local healthBg = Instance.new("Frame", bill)
		healthBg.Size = UDim2.new(0.8, 0, 0, 4)
		healthBg.Position = UDim2.new(0.1, 0, 0.6, 0)
		healthBg.BackgroundColor3 = Color3.fromRGB(50, 0, 0)
		healthBg.BorderSizePixel = 0

		local healthBar = Instance.new("Frame", healthBg)
		healthBar.Size = UDim2.new(1, 0, 1, 0)
		healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
		healthBar.BorderSizePixel = 0

		local conn;
		conn = RunService.Heartbeat:Connect(function()
			if not character.Parent or not head.Parent or not root.Parent or not hum.Parent then 
				if conn then conn:Disconnect() end 
				return 
			end
			local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if myRoot then
				local dist = (myRoot.Position - root.Position).Magnitude
				local display = {}
				if states.espName then table.insert(display, customName) end
				if states.espDistance then table.insert(display, math.floor(dist) .. "m") end
				txt.Text = table.concat(display, " | ")
				
				local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
				healthBar.Size = UDim2.new(pct, 0, 1, 0)
			end
		end)
		table.insert(cacheObjects, conn)
		table.insert(cacheObjects, bill)
	end
	espCache[character] = cacheObjects
end

local function forceRefreshESP()
	for char, _ in pairs(espCache) do clearESP(char) end
	for _, p in ipairs(Players:GetPlayers()) do if p ~= player and p.Character then createESP(p.Name, p.Character) end end
	if states.betaMode and dummyBot and dummyBot.Parent then
		createESP("[BETA BOT]", dummyBot)
	end
end

--========================
-- ⚙️ HỆ THỐNG GIẢ LẬP BETA TRONG ROBLOX STUDIO
--========================
local function spawnBetaDummy()
	if not RunService:IsStudio() then return end
	if dummyBot and dummyBot.Parent then dummyBot:Destroy() end
	
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	
	local model = Instance.new("Model")
	model.Name = "NovaBetaDummy"
	
	local parts = {"HumanoidRootPart", "Head", "UpperTorso", "LowerTorso"}
	local createdParts = {}
	
	for _, name in ipairs(parts) do
		local p = Instance.new("Part")
		p.Name = name
		p.Size = (name == "Head") and Vector3.new(1.2, 1.2, 1.2) or Vector3.new(2, 2, 1)
		p.CanCollide = true
		p.Anchored = false
		p.Parent = model
		createdParts[name] = p
	end
	
	createdParts.HumanoidRootPart.CFrame = myRoot.CFrame * CFrame.new(0, 0, -8)
	createdParts.Head.CFrame = createdParts.HumanoidRootPart.CFrame * CFrame.new(0, 2, 0)
	createdParts.UpperTorso.CFrame = createdParts.HumanoidRootPart.CFrame * CFrame.new(0, 0.5, 0)
	createdParts.LowerTorso.CFrame = createdParts.HumanoidRootPart.CFrame * CFrame.new(0, -0.5, 0)
	
	for name, part in pairs(createdParts) do
		if name ~= "HumanoidRootPart" then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = createdParts.HumanoidRootPart
			weld.Part1 = part
			weld.Parent = createdParts.HumanoidRootPart
		end
	end
	
	local hum = Instance.new("Humanoid", model)
	hum.MaxHealth = 100
	hum.Health = 100
	
	hum.Died:Connect(function()
		totalKillsSession = totalKillsSession + 1
		killLabel.Text = "Kills Đã Đạt: " .. totalKillsSession
		clearESP(model)
		task.wait(2)
		if states.betaMode then spawnBetaDummy() end
	end)
	
	model.Parent = workspace
	dummyBot = model
	
	if states.espGlobal then createESP("[BETA BOT]", dummyBot) end
end

local function removeBetaDummy()
	if dummyBot then
		clearESP(dummyBot)
		dummyBot:Destroy()
		dummyBot = nil
	end
end

--========================
-- ⚔️ CƠ CHẾ CHÉM VẬT LÝ + ANIMATION
--========================
local function scanKnifeTarget()
	if states.betaMode and dummyBot and dummyBot:FindFirstChild("HumanoidRootPart") then
		local hum = dummyBot:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then return dummyBot end
	end

	local best = nil
	local minDist = math.huge
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and not p.Character:FindFirstChildOfClass("ForceField") then
				local d = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
				if d < minDist then minDist = d best = p.Character end
			end
		end
	end
	return best
end

local function playSlashAnimation()
	pcall(function()
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
		
		if lastAnimator ~= animator or not loadedTrack then
			lastAnimator = animator
			loadedTrack = animator:LoadAnimation(slashAnimationInstance)
			loadedTrack.Priority = Enum.AnimationPriority.Action
		end
		
		if loadedTrack then
			loadedTrack:Play(0.1, 1, 1.5)
		end
	end)
end

local function simulatePhysicalClick(targetChar)
	pcall(function()
		local tool = player.Character:FindFirstChildOfClass("Tool") or player.Backpack:FindFirstChildOfClass("Tool")
		if tool and tool.Parent ~= player.Character then tool.Parent = player.Character end
		
		playSlashAnimation()
		
		Vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
		task.wait(0.01)
		Vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
		
		if states.betaMode and targetChar == dummyBot then
			local hum = targetChar:FindFirstChildOfClass("Humanoid")
			if hum then hum.Health = math.max(0, hum.Health - math.random(10, 15)) end
		end
	end)
end

task.spawn(function()
	while true do
		task.wait(math.random(50, 75) / 1000)
		
		local targetChar = scanKnifeTarget()
		if targetChar and targetChar:FindFirstChild("HumanoidRootPart") and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local tRoot = targetChar.HumanoidRootPart
			local myRoot = player.Character.HumanoidRootPart
			
			if states.autoTeleport and tick() - teleportTick > 0.2 then
				pcall(function()
					local targetBehindPos = tRoot.Position + (tRoot.CFrame.LookVector * -2.5)
					myRoot.CFrame = CFrame.new(targetBehindPos, tRoot.Position)
				end)
				teleportTick = tick()
			end

			if states.killAura then
				local dist = (myRoot.Position - tRoot.Position).Magnitude
				if dist <= states.killAuraRange then
					camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, tRoot.Position), 0.35)
					simulatePhysicalClick(targetChar)
					
					local hum = targetChar:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health <= 0 and not states.betaMode and lastTarget ~= targetChar then
						lastTarget = targetChar
						totalKillsSession = totalKillsSession + 1
						killLabel.Text = "Kills Đã Đạt: " .. totalKillsSession
					end
				end
			end
		end
	end
end)

--========================
-- 🌐 LOOPS DI CHUYỂN TOÀN CỤC
--========================
RunService.Heartbeat:Connect(function()
	if not player.Character or not player.Character:FindFirstChildOfClass("Humanoid") then return end
	local hum = player.Character:FindFirstChildOfClass("Humanoid")
	local root = player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	if states.speedHack then
		hum.WalkSpeed = states.walkSpeedValue
	else
		if hum.WalkSpeed == states.walkSpeedValue then
			hum.WalkSpeed = 16 
		end
	end

	if states.noclip then
		for _, v in ipairs(player.Character:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end
	end

	if states.fly then
		if not root:FindFirstChild("NovaFlyV") then
			local bv = Instance.new("BodyVelocity", root) bv.Name = "NovaFlyV" bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
			local bg = Instance.new("BodyGyro", root) bg.Name = "NovaFlyG" bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
		end
		root.NovaFlyV.velocity = camera.CFrame.LookVector * states.flySpeed
		root.NovaFlyG.cframe = camera.CFrame
	else
		if root:FindFirstChild("NovaFlyV") then root.NovaFlyV:Destroy() end
		if root:FindFirstChild("NovaFlyG") then root.NovaFlyG:Destroy() end
	end
end)

UIS.JumpRequest:Connect(function()
	if states.infJump and player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
		player.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

