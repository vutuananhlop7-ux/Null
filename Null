local function createToggle(parent, name, stateKey, subKey, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.95, 0, 0, 36)
	btn.Font = Enum.Font.SourceSansPro
	btn.TextSize = 14
	btn.TextColor3 = Color3.new(1, 1, 1)
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

	local function update()
		local currentBool = subKey and stateKey[subKey] or stateKey
		btn.Text = "  " .. name .. " : " .. (currentBool and "ON" or "OFF")
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.BackgroundColor3 = currentBool and Color3.fromRGB(40, 110, 80) or Color3.fromRGB(130, 45, 45)
	end

	update()
	btn.MouseButton1Click:Connect(function()
		if subKey then stateKey[subKey] = not stateKey[subKey] callback(stateKey[subKey])
		else _G[name.."_state"] = not _G[name.."_state"] callback(_G[name.."_state"]) end
		update()
	end)
	btn.Parent = parent
end

--========================
-- 🔴 MEMORY OPTIMIZED ESP
--========================
local function clearESP(character)
	if espCache[character] then
		for _, item in ipairs(espCache[character]) do
			if typeof(item) == "RBXScriptConnection" then item:Disconnect()
			elseif typeof(item) == "Instance" and item.Parent then item:Destroy() end
		end
		espCache[character] = nil
	end
end

local function createESP(plr, character)
	if not espEnabled or espCache[character] then return end
	local hum = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not hum or not head or not root then return end

	local cacheObjects = {}

	if espSettings.highlight then
		local hl = Instance.new("Highlight")
		hl.DepthMode = espSettings.wall and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
		hl.FillColor = Color3.fromRGB(240, 50, 50)
		hl.FillTransparency = 0.6
		hl.Parent = character
		table.insert(cacheObjects, hl)
	end

	if espSettings.name or espSettings.distance then
		local bill = Instance.new("BillboardGui")
		bill.Size = UDim2.new(0, 150, 0, 35)
		bill.AlwaysOnTop = true
		bill.Adornee = head

		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.new(1, 0, 1, 0)
		txt.BackgroundTransparency = 1
		txt.TextColor3 = Color3.new(1, 1, 1)
		txt.TextSize = 12
		txt.Font = Enum.Font.SourceSansBold
		txt.Parent = bill
		bill.Parent = head
		table.insert(cacheObjects, bill)

		local renderConn
		renderConn = RunService.Heartbeat:Connect(function()
			if not character.Parent or not head.Parent or not bill.Parent then if renderConn then renderConn:Disconnect() end return end
			-- Dynamic Distance Opt: Khoảng cách > 250m tự động ẩn chữ để nhẹ RAM
			local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if myRoot then
				local dist = (myRoot.Position - root.Position).Magnitude
				if dist > 250 then txt.Text = "" return end
				
				local info = {}
				if espSettings.name then table.insert(info, plr.Name) end
				if espSettings.distance then table.insert(info, math.floor(dist) .. "m") end
				txt.Text = table.concat(info, " | ")
			end
		end)
		table.insert(cacheObjects, renderConn)
	end
	espCache[character] = cacheObjects
end

local function refreshESP()
	for _, plr in ipairs(Players:GetPlayers()) do if plr ~= player and plr.Character then clearESP(plr.Character) createESP(plr, plr.Character) end end
end

--========================
-- 🔥 CORES: SMART AUTO KILL MECHANICS
--========================
local function getBestTarget()
	local closestPlr = nil
	local shortestDistance = math.huge
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	if not myRoot then return nil end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChildOfClass("Humanoid") then
			local hum = plr.Character.Humanoid
			if hum.Health > 0 then
				local dist = (myRoot.Position - plr.Character.HumanoidRootPart.Position).Magnitude
				if dist < shortestDistance then
					-- Kiểm tra chống kẹt: Nếu mục tiêu này đang làm mình bị kẹt, tạm thời bỏ qua
					if lastTarget == plr and targetStuckTimer > 5 then
						continue
					end
					shortestDistance = dist
					closestPlr = plr
				end
			end
		end
	end
	return closestPlr
end

task.spawn(function()
	while true do
		task.wait(0.25)
		if not keyVerified then continue end

		local target = getBestTarget()
		if target and target.Character and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local targetRoot = target.Character.HumanoidRootPart
			local myRoot = player.Character.HumanoidRootPart

			-- Xử lý bộ đếm chống kẹt thông minh
			if lastTarget == target then
				targetStuckTimer = targetStuckTimer + 0.25
			else
				lastTarget = target
				targetStuckTimer = 0
			end

			-- 1. Auto Teleport Mod
			if autoKillEnabled then
				myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3.2)
			end

			-- 2. Kill Aura Pro
			if killAuraEnabled then
				local distance = (myRoot.Position - targetRoot.Position).Magnitude
				if distance <= killAuraRange then
					camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, targetRoot.Position), 0.3)
					
					pcall(function()
						VirtualUser:CaptureController()
						VirtualUser:ClickButton1(Vector2.new(0, 0))
					end)
					
					-- Mô phỏng việc đếm lượt hạ gục dựa trên trạng thái máu của mục tiêu giảm về 0
					local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
					if targetHum and targetHum.Health <= 0 then
						totalKillsSession = totalKillsSession + 1
						killLabel.Text = "Kills Đã Đạt: " .. totalKillsSession
						task.wait(0.1)
					end
				end
			end
		else
			targetStuckTimer = 0
		end
	end
end)

--========================
-- 🧊 BAY & XUYÊN TƯỜNG (SMART HEARTBEAT)
--========================
local flyBodyGyro, flyBodyVelocity
RunService.Heartbeat:Connect(function()
	if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
	local root = player.Character.HumanoidRootPart
	local hum = player.Character:FindFirstChildOfClass("Humanoid")

	if noclipEnabled then
		for _, part in ipairs(player.Character:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
	end

	if flyEnabled then
		if not flyBodyGyro then
			flyBodyGyro = Instance.new("BodyGyro", root)
			flyBodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
			flyBodyVelocity = Instance.new("BodyVelocity", root)
			flyBodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
		end
		flyBodyGyro.cframe = camera.CFrame
		flyBodyVelocity.velocity = camera.CFrame.LookVector * flySpeed
	else
		if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
		if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
	end
end)

UIS.JumpRequest:Connect(function()
	if infJumpEnabled and player.Character then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

