local function clearESP(c)
	if espCache[c] then
		for _, v in pairs(espCache[c]) do if typeof(v) == "Instance" then v:Destroy() end end
	end
	espCache[c] = nil
end

local function createESP(plr, c)
	if not espEnabled or espCache[c] or plr == player then return end
	local head = c:WaitForChild("Head", 4)
	local root = c:WaitForChild("HumanoidRootPart", 4)
	if not head or not root then return end

	local objs = {}
	if espSettings.highlight then
		local hl = Instance.new("Highlight", c)
		hl.DepthMode = espSettings.wall and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
		hl.FillColor = Theme.Accent
		table.insert(objs, hl)
	end

	if espSettings.name or espSettings.health or espSettings.distance then
		local bill = Instance.new("BillboardGui", head)
		bill.Size = UDim2.new(0, 150, 0, 45)
		bill.AlwaysOnTop = true
		bill.ExtentsOffset = Vector3.new(0, 2.5, 0)

		local txt = Instance.new("TextLabel", bill)
		txt.Size = UDim2.new(1, 0, 1, 0)
		txt.BackgroundTransparency = 1
		txt.TextColor3 = Color3.new(1, 1, 1)
		txt.Font = Enum.Font.GothamBold
		txt.TextSize = 11
		txt.TextStrokeTransparency = 0.5
		table.insert(objs, bill)
	end
	espCache[c] = objs
end

task.spawn(function()
	while true do
		task.wait(0.1)
		if espEnabled then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and plr.Character and espCache[plr.Character] then
					local char = plr.Character
					local hum = char:FindFirstChildOfClass("Humanoid")
					local root = char:FindFirstChild("HumanoidRootPart")
					local head = char:FindFirstChild("Head")
					if head and hum and root then
						local bill = head:FindFirstChildOfClass("BillboardGui")
						local txt = bill and bill:FindFirstChildOfClass("TextLabel")
						if txt then
							local info = {}
							if espSettings.name then table.insert(info, plr.Name) end
							if espSettings.health then table.insert(info, "HP: " .. math.floor(hum.Health)) end
							if espSettings.distance and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
								table.insert(info, math.floor((player.Character.HumanoidRootPart.Position - root.Position).Magnitude) .. "m")
							end
							txt.Text = table.concat(info, " | ")
						end
					end
				end
			end
		end
	end
end)

--========================
-- 🧠 ADVANCED COMBAT A.I
--========================
local function startAI()
	if aiConnection then aiConnection:Disconnect() end
	aiConnection = RunService.RenderStepped:Connect(function()
		if not aiRunning then return end
		local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not myRoot then return end

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character then
				local root = plr.Character:FindFirstChild("HumanoidRootPart")
				local head = plr.Character:FindFirstChild("Head")
				if root and head then
					local dist = (myRoot.Position - root.Position).Magnitude
					local isLooking = head.CFrame.LookVector:Dot((myRoot.Position - head.Position).Unit) > 0.75
					local threatColor = isLooking and (dist < 15 and Color3.fromRGB(255,0,50) or Color3.fromRGB(255,165,0)) or Color3.fromRGB(0,255,100)
					
					if dist < 15 and isLooking and not aiCooldown[plr.Name .. "_ev"] then
						aiCooldown[plr.Name .. "_ev"] = tick()
						notify("⚡ NÉ MAU! " .. plr.Name .. " áp sát cực nguy hiểm!")
					end

					local velocity = root.AssemblyLinearVelocity
					if velocity.Magnitude > 2 then
						local line = aiDrawings[plr.Name] or Instance.new("Part")
						line.Anchored = true; line.CanCollide = false; line.Material = Enum.Material.Neon; line.Parent = workspace
						local endPos = (root.Position - Vector3.new(0,2,0)) + (velocity * 0.6)
						line.Size = Vector3.new(0.2, 0.2, (endPos - (root.Position - Vector3.new(0,2,0))).Magnitude)
						line.CFrame = CFrame.lookAt(root.Position - Vector3.new(0,2,0), endPos) * CFrame.new(0,0, -line.Size.Z/2)
						line.Color = threatColor
						aiDrawings[plr.Name] = line
					elseif aiDrawings[plr.Name] then
						aiDrawings[plr.Name]:Destroy(); aiDrawings[plr.Name] = nil
					end
				end
			end
		end
	end)
end

--========================
-- 🔥 THE DESTROYER ENGINE (BÁ CHÁY CHÍNH Ở ĐÂY)
--========================
RunService.Stepped:Connect(function()
	local myChar = player.Character
	if not myChar then return end

	-- 1. ĐI XUYÊN TƯỜNG (NOCLIP)
	if noclipEnabled then
		for _, v in pairs(myChar:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end
	end

	-- 2. HITBOX EXPANDER (PHÓNG TO ĐỊCH)
	if hitboxExpanderEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
				local root = plr.Character.HumanoidRootPart
				root.Size = Vector3.new(12, 12, 12)
				root.Transparency = 0.7
				root.Color = Theme.Accent
				root.Material = Enum.Material.Neon
				root.CanCollide = false
			end
		end
	end

	-- 3. ANTI-VOID (CHỐNG RƠI VỰC)
	if antiVoidEnabled and myChar:FindFirstChild("HumanoidRootPart") then
		local myRoot = myChar.HumanoidRootPart
		if myRoot.Position.Y < -50 then -- Nếu rớt xuống sâu dưới tọa độ -50
			myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0) -- Hãm phanh gia tốc rơi
			myRoot.CFrame = CFrame.new(myRoot.Position.X, 20, myRoot.Position.Z) -- Kéo giật đầu bay lên lại
			notify("🛡 ANTI-VOID: Đã cứu bạn khỏi hố tử thần!")
		end
	end

	-- 4. ITEM MAGNET (HÚT ĐỒ VẬT PHẨM)
	if itemMagnetEnabled and myChar:FindFirstChild("HumanoidRootPart") then
		for _, v in ipairs(workspace:GetDescendants()) do
			if v:IsA("BasePart") and not v.Anchored and (v:IsA("MeshPart") or v.Name:lower():find("item") or v.Name:lower():find("coin") or v.Name:lower():find("drop")) then
				if (v.Position - myChar.HumanoidRootPart.Position).Magnitude < 150 then -- Bán kính quét 150m
					v.CFrame = myChar.HumanoidRootPart.CFrame
				end
			end
		end
	end
end)

-- Trả hitbox về bình thường khi tắt tính năng tránh lỗi game
local function resetHitboxes()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
			plr.Character.HumanoidRootPart.Size = Vector3.new(2, 2, 1)
			plr.Character.HumanoidRootPart.Transparency = 1
		end
	end
end

