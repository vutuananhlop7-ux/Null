local function createToggle(parent, name, currentState, callback)
	local base = Instance.new("Frame", parent)
	base.Size = UDim2.new(1, 0, 0, 35)
	base.BackgroundColor3 = Theme.Sidebar
	roundCorners(base, 6)

	local lbl = Instance.new("TextLabel", base)
