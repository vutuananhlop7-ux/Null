task.spawn(function()
	repeat task.wait(0.5) until player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	notify("🎯 Đã nạp Module: A.I Phân Tích Hành Vi & Dự Báo Chiến Thuật!")

	local function getDirectionName(myRoot, targetRoot)
		local relPos = (targetRoot.Position - myRoot.Position).Unit
		local angle = math.atan2(relPos.X, relPos.Z) * (180 / math.pi)
		if angle < 0 then angle = angle + 360 end
		
		if angle >= 337.5 or angle < 22.5 then return "Bắc (N)"
		elseif angle >= 22.5 and angle < 67.5 then return "Đông Bắc (NE)"
		elseif angle >= 67.5 and angle < 112.5 then return "Đông (E)"
		elseif angle >= 112.5 and angle < 157.5 then return "Đông Nam (SE)"
		elseif angle >= 157.5 and angle < 202.5 then return "Nam (S)"
		elseif angle >= 202.5 and angle < 247.5 then return "Tây Nam (SW)"
		elseif angle >= 247.5 and angle < 292.5 then return "Tây (W)"
		elseif angle >= 292.5 and angle < 337.5 then return "Tây Bắc (NW)"
		end
		return "Không xác định"
	end

	local function analyzeBehavior(char, hum, velocity)
		if hum.Health <= 0 then return "ĐÃ CHẾT 💀", Color3.fromRGB(150,150,150) end
		
		local isArmed = char:FindFirstChildOfClass("Tool") ~= nil
		local speed = velocity.Magnitude

		if speed < 1 then
			return isArmed and "Thủ Thế (Đang cầm vũ khí) ⚔️" or "Đứng Yên 🧍", Color3.fromRGB(240, 240, 240)
		elseif hum:GetState() == Enum.HumanoidStateType.Jumping or hum:GetState() == Enum.HumanoidStateType.FreeFall then
			return "Đang Nhảy / Không kích 🪂", Color3.fromRGB(0, 180, 255)
		elseif speed > 22 then
			return "Đang Chạy Tốc Độ Cao 🏃‍♂️💨", Color3.fromRGB(255, 100, 0)
		else
			return isArmed and "Áp Sát Tấn Công ⚔️" or "Di Chuyển Thường 🏃", Color3.fromRGB(200, 200, 200)
		end
	end

	RunService.RenderStepped:Connect(function()
		if not aiRunning then return end
		
		local myChar = player.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if not myRoot then return end

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character then
				local char = plr.Character
				local root = char:FindFirstChild("HumanoidRootPart")
				local head = char:FindFirstChild("Head")
				local hum = char:FindFirstChildOfClass("Humanoid")
				
				if root and head and hum then
					local bill = head:FindFirstChildOfClass("BillboardGui")
					if bill then
						bill.Size = UDim2.new(0, 220, 0, 110)
						bill.ExtentsOffset = Vector3.new(0, 4.5, 0)

						local aiHUD = bill:FindFirstChild("AdvancedAIHUD")
						if not aiHUD then
							aiHUD = Instance.new("Frame", bill)
							aiHUD.Name = "AdvancedAIHUD"
							aiHUD.Size = UDim2.new(1, 0, 1, 0)
							aiHUD.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
							aiHUD.BackgroundTransparency = 0.25
							
							local corner = Instance.new("UICorner", aiHUD)
							corner.CornerRadius = UDim.new(0, 6)
							local stroke = Instance.new("UIStroke", aiHUD)
							stroke.Color = Theme.Accent
							stroke.Thickness = 1
							
							local list = Instance.new("UIListLayout", aiHUD)
							list.Padding = UDim.new(0, 1)
							list.HorizontalAlignment = Enum.HorizontalAlignment.Left
							
							for i = 1, 5 do
								local line = Instance.new("TextLabel", aiHUD)
								line.Name = "Line" .. i
								line.Size = UDim2.new(1, -10, 0, 18)
								line.Position = UDim2.new(0, 8, 0, 0)
								line.BackgroundTransparency = 1
								line.Font = Enum.Font.GothamBold
								line.TextSize = 10
								line.TextXAlignment = Enum.TextXAlignment.Left
								line.TextColor3 = Color3.fromRGB(230, 230, 230)
							end
						end

						local oldTag = bill:FindFirstChild("AITag")
						if oldTag then oldTag.Visible = false end

						local oldTxt = bill:FindFirstChildOfClass("TextLabel")
						if oldTxt and oldTxt.Name ~= "Line1" then oldTxt.TextTransparency = 1 end

						local distance = (myRoot.Position - root.Position).Magnitude
						local velocity = root.AssemblyLinearVelocity
						local directionName = getDirectionName(myRoot, root)
						
						local behaviorText, behaviorColor = analyzeBehavior(char, hum, velocity)

						local relVelocity = root.AssemblyLinearVelocity - myRoot.AssemblyLinearVelocity
						local toMe = (myRoot.Position - root.Position).Unit
						local closingSpeed = relVelocity:Dot(toMe)
						
						local etaText = "Đang đứng yên / Di chuyển xa dần"
						if closingSpeed > 1 then
							local etaTime = distance / closingSpeed
							etaText = string.format("%.1f giây ⏳", etaTime)
						end

						local isArmed = char:FindFirstChildOfClass("Tool") ~= nil
						local isLookingAtMe = head.CFrame.LookVector:Dot((myRoot.Position - head.Position).Unit) > 0.7
						local canAttack = "KHÔNG THỂ TRÚNG ✕"
						local attackColor = Color3.fromRGB(0, 255, 100)

						if distance <= 16 and isArmed then
							canAttack = "CÓ THỂ CẬN CHIẾN! Đang cầm vũ khí ⚔️"
							attackColor = Color3.fromRGB(255, 50, 50)
						elseif distance > 16 and distance <= 120 and isArmed and isLookingAtMe then
							canAttack = "NGUY HIỂM: Đang nhắm bắn bạn 🎯"
							attackColor = Color3.fromRGB(255, 120, 0)
						elseif not isArmed then
							canAttack = "An Toàn (Địch không cầm vũ khí) ✔️"
						end

						aiHUD.Line1.Text = " 👤 MỤC TIÊU: " .. plr.Name .. " (" .. math.floor(distance) .. "m)"
						aiHUD.Line2.Text = " 🧭 HƯỚNG ĐỊCH: " .. directionName
						aiHUD.Line3.Text = " 🧠 HÀNH VI: " .. behaviorText
						aiHUD.Line3.TextColor3 = behaviorColor
						aiHUD.Line4.Text = " ⏱ DỰ BÁO TIẾP CẬN: " .. etaText
						aiHUD.Line5.Text = " ⚡ KHẢ NĂNG TẤN CÔNG: " .. canAttack
						aiHUD.Line5.TextColor3 = attackColor
					end
				end
			end
		end
	end)
end)

