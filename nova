	lbl.Position = UDim2.new(0, 10, 0, 0)
	lbl.Text = name
	lbl.TextColor3 = Theme.Text
	lbl.Font = Enum.Font.Gotham
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.BackgroundTransparency = 1

	local btn = Instance.new("TextButton", base)
	btn.Size = UDim2.new(0, 50, 0, 22)
	btn.Position = UDim2.new(1, -60, 0.5, -11)
	btn.Text = ""
	roundCorners(btn, 11)

	local indicator = Instance.new("Frame", btn)
	indicator.Size = UDim2.new(0, 18, 0, 18)
	indicator.Position = currentState and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
	indicator.BackgroundColor3 = Theme.Text
	roundCorners(indicator, 9)

	local function updateVisuals()
		btn.BackgroundColor3 = currentState and Theme.ToggleOn or Theme.ToggleOff
		tween(indicator, 0.2, {
			Position = currentState and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
		})
	end
	updateVisuals()

	btn.MouseButton1Click:Connect(function()
		currentState = not currentState
		updateVisuals()
		callback(currentState)
	end)
end

