									if hum and hum:GetState() ~= Enum.HumanoidStateType.Jumping then
										myRoot.AssemblyLinearVelocity = (myRoot.CFrame.LookVector * -45) + Vector3.new(0, 30, 0)
										notify("🛡️ AI REFLEX: Đã tự động kích hoạt Né Tránh Phản Xạ!")
										task.wait(1.5)
									end
								end
							end
						end
					end
				end
			end
		end
	end)

	local function boostFPS()
		for _, v in ipairs(Lighting:GetDescendants()) do
			if v:IsA("PostEffect") or v:IsA("GlobalShadows") then v.Enabled = false end
		end
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		notify("⚡ Thần tốc: Đã tối ưu hóa đồ họa môi trường để gánh Aimbot!")
	end
	
	if main then
		main:GetPropertyChangedSignal("Visible"):Connect(function()
			if main.Visible then boostFPS() end
		end)
	end
end)

