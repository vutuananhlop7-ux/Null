--===================================================================================
-- 🥀 ROSE PvP ASSISTANT v8.0 [RIVALS SAFE EDITION]
-- Chức năng: ESP (Nhìn xuyên) + Smooth Lock Cam (Hỗ trợ ngắm mượt)
-- KHÔNG CÓ NOCLIP để tránh bị Anti-cheat ban ngay lập tức.
--===================================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

-- ==========================================
-- 🛠️ CẤU HÌNH HỖ TRỢ (Nên giữ mặc định để an toàn)
-- ==========================================
local isEnabled = false
local Aim_FOV = 150          -- Vòng tròn giới hạn hỗ trợ ngắm (Pixels)
local Smoothness = 0.15       -- Độ mượt khi lock (Càng thấp càng mượt, trông càng giống người)
local ESP_Enabled = true
local TeamCheck = true        -- Chỉ ESP và Lock vào kẻ địch (Khác Team)

-- ==========================================
-- 🎨 UI THEME & DRAWING (Dùng CoreGui để né quét)
-- ==========================================
local Theme = { Accent = Color3.fromRGB(255, 0, 85), Text = Color3.fromRGB(245, 245, 245), Enemy = Color3.fromRGB(220, 40, 60), Friendly = Color3.fromRGB(0, 220, 120) }

local Folder = Instance.new("Folder")
Folder.Name = "Rose_ESP"
Folder.Parent = CoreGui

-- Vòng tròn FOV
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1
FOVCircle.Filled = false
FOVCircle.Color = Theme.Accent
FOVCircle.Transparency = 0.5
FOVCircle.Visible = false

-- ==========================================
-- 🧠 HỆ THỐNG XỬ LÝ CHÍNH
-- ==========================================

-- 1. Hàm tạo ESP Box và Tên
local function CreateESP(player)
	local Box = Drawing.new("Square")
	Box.Thickness = 1
	Box.Filled = false
	Box.Transparency = 0.8
	
	local NameLabel = Drawing.new("Text")
	NameLabel.Text = player.Name
	NameLabel.Size = 13
	NameLabel.Center = true
	NameLabel.Outline = true
	NameLabel.Color = Theme.Text

	local updater
	updater = RunService.RenderStepped:Connect(function()
		if ESP_Enabled and isEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 and player ~= LocalPlayer then
			
			-- Team Check color
			if TeamCheck and player.Team == LocalPlayer.Team then
				Box.Color = Theme.Friendly
				NameLabel.Color = Theme.Friendly
			else
				Box.Color = Theme.Enemy
				NameLabel.Color = Theme.Enemy
			end

			local rpart = player.Character.HumanoidRootPart
			local screenPos, onScreen = Camera:WorldToViewportPoint(rpart.Position)

			if onScreen then
				-- Tính toán kích thước Box dựa trên khoảng cách
				local distance = (Camera.CFrame.Position - rpart.Position).Magnitude
				local sizeX = 2000 / distance
				local sizeY = 3000 / distance

				Box.Size = Vector2.new(sizeX, sizeY)
				Box.Position = Vector2.new(screenPos.X - sizeX / 2, screenPos.Y - sizeY / 2)
				Box.Visible = true

				NameLabel.Position = Vector2.new(screenPos.X, screenPos.Y - (sizeY / 2) - 15)
				NameLabel.Visible = true
			else
				Box.Visible = false
				NameLabel.Visible = false
			end
		else
			Box.Visible = false
			NameLabel.Visible = false
			if not player.Parent then -- Player out game
				Box:Remove()
				NameLabel:Remove()
				updater:Disconnect()
			end
		end
	end)
end

-- 2. Khởi tạo ESP cho player hiện tại và mới vào
if ESP_Enabled then
	for _, p in ipairs(Players:GetPlayers()) do CreateESP(p) end
	Players.PlayerAdded:Connect(CreateESP)
end

-- 3. Hàm tìm kẻ địch gần tâm chuột nhất trong FOV
local function getClosestEnemyInFOV()
	local closest, shortestDist = nil, Aim_FOV
	local mousePos = Vector2.new(Mouse.X, Mouse.Y + 36) -- Bù trừ offset top bar

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if TeamCheck and player.Team == LocalPlayer.Team then continue end

			local char = player.Character
			if char and char:FindFirstChild("Head") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
				local head = char.Head
				local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)

				if onScreen then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
					if dist < shortestDist then
						shortestDist = dist
						closest = head
					end
				end
			end
		end
	end
	return closest
end

-- 4. Vòng lặp khóa tâm mượt mà (Smooth Lock)
RunService.RenderStepped:Connect(function()
	-- Cập nhật vòng FOV theo chuột
	FOVCircle.Position = Vector2.new(Mouse.X, Mouse.Y + 36)
	FOVCircle.Radius = Aim_FOV
	FOVCircle.Visible = isEnabled

	if isEnabled then
		local target = getClosestEnemyInFOV()
		if target then
			-- Chuyển đổi CFrame Camera mượt mà về phía mục tiêu
			local targetCFrame = CFrame.new(Camera.CFrame.Position, target.Position)
			Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Smoothness)
		end
	end
end)

-- ==========================================
-- 🎹 LỆNH ĐIỀU KHIỂN
-- ==========================================
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	-- Phím G: Bật/Tắt chế độ hỗ trợ
	if input.KeyCode == Enum.KeyCode.G then
		isEnabled = not isEnabled
		print("🥀 Rose PvP: " .. (isEnabled and "ENABLED" or "DISABLED"))
		
		-- Thông báo dạng Text Drawing (né quét UI)
		local msg = Drawing.new("Text")
		msg.Text = isEnabled and "🥀 ROSE PvP: ON" or "🥀 ROSE PvP: OFF"
		msg.Color = isEnabled and Theme.Friendly or Theme.Enemy
		msg.Position = Vector2.new(Camera.ViewportSize.X/2, 100)
		msg.Center = true
		msg.Size = 20
		msg.Outline = true
		msg.Visible = true
		task.delay(2, function() msg:Remove() end)
	end
end)

print("=========================================")
print("🥀 ROSE PvP ASSISTANT v8.0 LOADED")
print("Press [G] to Toggle ESP & Smooth Aim")
