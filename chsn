-- 1. Tự động tương tác với ProximityPrompt của NPC theo cơ chế chuẩn Studio
local function autoInteractWithQuestNPC()
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return false end
	
	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("ProximityPrompt") then
			local parentModel = v:FindFirstAncestorOfClass("Model")
			if parentModel and parentModel ~= LocalPlayer.Character then
				local npcRoot = parentModel:FindFirstChild("HumanoidRootPart") or parentModel:FindFirstChildWhichIsA("BasePart")
				if npcRoot then
					local nameLower = parentModel.Name:lower() .. v.ObjectText:lower() .. v.ActionText:lower()
					if nameLower:find("quest") or nameLower:find("nhiệm vụ") or nameLower:find("nv") then
						updateUI("Đang nhận/trả nhiệm vụ...", true, parentModel.Name)
						safeTeleport(npcRoot.CFrame * CFrame.new(0, 0, -3.5))
						task.wait(0.3)
						
						-- 👉 THAY THẾ CHÍNH THỨC: Giả lập tương tác Prompt an toàn trên hệ thống Roblox
						v:InputBegan(Enum.UserInputType.MouseButton1, LocalPlayer)
						task.wait(0.2)
						return true
					end
				end
			end
		end
	end
	return false
end

-- 2. Tự động định vị Quái vật gần nhất trong Workspace
local function findAnyTargetMonster()
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	local closestMonster = nil
	local shortestDistance = SCAN_RANGE

	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v ~= myChar then
			local hum = v.Humanoid
			-- Lọc: Chỉ quái còn sống và bỏ qua các Model có lượng máu vô tận (thường là NPC/Bảo tàng)
			if hum.Health > 0 and hum.MaxHealth < 500000 then 
				local dist = (myRoot.Position - v.HumanoidRootPart.Position).Magnitude
				if dist < shortestDistance then
					closestMonster = v
					shortestDistance = dist
				end
			end
		end
	end
	return closestMonster
end

-- ==========================================
-- 🔄 CORE ENGINE LOOP
-- ==========================================
local function startUniversalFarm()
	isAutoing = true
	
	while isAutoing do
		local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local hum = char:WaitForChild("Humanoid")
		
		-- Bước 1: Quét và tương tác NPC nhận nhiệm vụ gần nhất
		autoInteractWithQuestNPC()
		if not isAutoing then break end
		
		-- Bước 2: Tìm quái cày cấp
		updateUI("Đang định vị mục tiêu...", true)
		local targetMob = findAnyTargetMonster()
		
		if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
			while isAutoing and targetMob and targetMob:FindFirstChild("HumanoidRootPart") and targetMob.Humanoid.Health > 0 do
				updateUI("Đang tự động thực hiện hành vi", true, targetMob.Name .. " (" .. math.floor(targetMob.Humanoid.Health) .. " HP)")
				
				-- Giữ nhân vật khóa vị trí phía trên đầu quái vật 3 studs (Tránh nhận sát thương cận chiến của quái)
				char.HumanoidRootPart.CFrame = targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 3, 0) * CFrame.Angles(math.rad(-90), 0, 0)
				
				-- Tự động kích hoạt Tool người chơi đang sở hữu
				local tool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool") or char:FindFirstChildOfClass("Tool")
				if tool then
					if tool.Parent ~= char then hum:EquipTool(tool) end
					tool:Activate()
				end
				task.wait(ATTACK_DELAY)
			end
		else
			updateUI("⏳ Đang đợi mục tiêu xuất hiện...", true)
			task.wait(1)
		end
		
		task.wait(0.1)
	end
end

local function stopUniversalFarm()
	isAutoing = false
	toggleNoclip(false)
	updateUI("Đã tắt", false, "Trống")
end

